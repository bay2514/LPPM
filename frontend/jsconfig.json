{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/app/*"],
      "@public/*": ["src/public/*"],
      "@admin/*": ["src/admin/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["src"]
}
